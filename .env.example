# Copiar a .env (el .env NO se sube al repo). Valores de ejemplo, no reales.

# --- Base de datos de turnos (la usa docker-compose.yml y la app) ---
DB_NAME=turnos_db
DB_PORT=5434
DB_USER=turnos
DB_PASSWORD=cambiar-esta-clave
DB_URL=jdbc:postgresql://localhost:5434/turnos_db

# --- Catalogo ---
CATALOGO_BASE_URL=http://localhost:8080

# --- Seguridad (JWT) ---
# Minimo 32 caracteres. Debe ser IDENTICO en catalogo-service y turnos-service.
# Generar uno: openssl rand -base64 48
JWT_SECRET=
