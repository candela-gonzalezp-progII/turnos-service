# Copiar a .env (el .env NO se sube al repo). Valores de ejemplo, no reales.

# --- Base de datos de turnos (la usa docker-compose.yml y la app) ---
DB_NAME=turnos_db
DB_PORT=5434
DB_USER=turnos
DB_PASSWORD=cambiar-esta-clave
DB_URL=jdbc:postgresql://localhost:5434/turnos_db

# --- Catalogo ---
CATALOGO_BASE_URL=http://localhost:8080

# --- Seguridad (JWT) ---
# Minimo 32 caracteres. Debe ser IDENTICO en catalogo-service y turnos-service.
# Generar uno: openssl rand -base64 48
JWT_SECRET=

# --- Catedra (cuenta tecnica UNICA, la misma en catalogo y turnos; datos reales solo en tu .env) ---
CATEDRA_BASE_URL=http://<direccion-de-la-catedra>:<puerto>
CATEDRA_USERNAME=
CATEDRA_PASSWORD=
# true cuando ya tengas la integracion Kafka provisionada (CU-12/CU-13)
CATEDRA_KAFKA_ENABLED=false


# CORS: origenes web permitidos separados por coma (vacio = ninguno)
CORS_ALLOWED_ORIGINS=
